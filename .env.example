# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jomudb
DB_USER=root
DB_PASSWORD=

# SMTP email
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=my_smtp_username
SMTP_PASSWORD=my_smtp_password
SMTP_FROM_EMAIL=no-reply@jomu.ug
SMTP_FROM_NAME=JoMu
SMTP_RESET_FROM_EMAIL=no-reply@jomu.ug
SMTP_RESET_FROM_NAME=JoMu
SMTP_FEEDBACK_FROM_EMAIL=support@jomu.ug
SMTP_FEEDBACK_FROM_NAME=JoMu Support
FEEDBACK_TO_EMAIL=support@jomu.ug
SUPPORT_EMAIL=support@jomu.ug

# Meta WhatsApp Cloud API
META_WHATSAPP_TOKEN=your_meta_system_user_access_token
META_WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
META_WHATSAPP_TEMPLATE_NAME=your_approved_auth_template_name
META_WHATSAPP_TEMPLATE_LANG=en_US
META_WHATSAPP_API_VERSION=v22.0

# Google Sign-In (Web)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional for local PHP/WAMP installs when curl.cainfo is empty.
CURL_CA_BUNDLE=
