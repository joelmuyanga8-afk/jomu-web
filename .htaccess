Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonical public URLs.
    RewriteCond %{THE_REQUEST} \s/+index\.php[?\s] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+about\.html[?\s] [NC]
    RewriteRule ^about\.html$ /about [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+businessbulkorders\.html[?\s] [NC]
    RewriteRule ^businessbulkorders\.html$ /bulk-orders [R=301,L]
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/+php/businessvendordashboard\.php[?\s] [NC]
    RewriteRule ^php/businessvendordashboard\.php$ /business-vendor-dashboard [R=301,L]
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/+php/addnewlisting\.php[?\s] [NC]
    RewriteRule ^php/addnewlisting\.php$ /add-new-listing [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+categoriesagriculture&produce\.html[?\s] [NC]
    RewriteRule ^categoriesagriculture&produce\.html$ /categories/agriculture-produce [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+categoriesapparel\.html[?\s] [NC]
    RewriteRule ^categoriesapparel\.html$ /categories/apparel [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+categoriesautomotive&transport\.html[?\s] [NC]
    RewriteRule ^categoriesautomotive&transport\.html$ /categories/automotive-transport [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+categoriesconstruction&building\.html[?\s] [NC]
    RewriteRule ^categoriesconstruction&building\.html$ /categories/construction-building [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+categorieselectronics&gagdets\.html[?\s] [NC]
    RewriteRule ^categorieselectronics&gagdets\.html$ /categories/electronics-gadgets [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+categoriesfood&beverages\.html[?\s] [NC]
    RewriteRule ^categoriesfood&beverages\.html$ /categories/food-beverages [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+categoriesfurniture&home\.html[?\s] [NC]
    RewriteRule ^categoriesfurniture&home\.html$ /categories/furniture-home [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+categoriesgeneralservices\.html[?\s] [NC]
    RewriteRule ^categoriesgeneralservices\.html$ /categories/general-services [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+categorieshealth&beauty\.html[?\s] [NC]
    RewriteRule ^categorieshealth&beauty\.html$ /categories/health-beauty [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+categoriesit&software\.html[?\s] [NC]
    RewriteRule ^categoriesit&software\.html$ /categories/it-software [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+categorieslivestock&animals\.html[?\s] [NC]
    RewriteRule ^categorieslivestock&animals\.html$ /categories/livestock-animals [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+categoriesofficesupply&stationery\.html[?\s] [NC]
    RewriteRule ^categoriesofficesupply&stationery\.html$ /categories/office-supply-stationery [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+categoriesprinting&branding\.html[?\s] [NC]
    RewriteRule ^categoriesprinting&branding\.html$ /categories/printing-branding [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+categorieswholesale&retail\.html[?\s] [NC]
    RewriteRule ^categorieswholesale&retail\.html$ /categories/wholesale-retail [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+createaccount\.html[?\s] [NC]
    RewriteRule ^createaccount\.html$ /create-account [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+feedback\.html[?\s] [NC]
    RewriteRule ^feedback\.html$ /feedback [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+help\.html[?\s] [NC]
    RewriteRule ^help\.html$ /help [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+newarrivalscentral\.php[?\s] [NC]
    RewriteRule ^newarrivalscentral\.php$ /new-arrivals/central [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+newarrivalseastern\.php[?\s] [NC]
    RewriteRule ^newarrivalseastern\.php$ /new-arrivals/eastern [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+newarrivalsnorthern\.php[?\s] [NC]
    RewriteRule ^newarrivalsnorthern\.php$ /new-arrivals/northern [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+newarrivalswestern\.php[?\s] [NC]
    RewriteRule ^newarrivalswestern\.php$ /new-arrivals/western [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+offers&discounts\.html[?\s] [NC]
    RewriteRule ^offers&discounts\.html$ /offers-discounts [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+privacypolicy\.html[?\s] [NC]
    RewriteRule ^privacypolicy\.html$ /privacy-policy [R=301,L]
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/+php/profile\.php[?\s] [NC]
    RewriteRule ^php/profile\.php$ /profile [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+purchasewholesale\.html[?\s] [NC]
    RewriteRule ^purchasewholesale\.html$ /purchase-wholesale [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+recentlyviewed\.html[?\s] [NC]
    RewriteRule ^recentlyviewed\.html$ /recently-viewed [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+signin\.html[?\s] [NC]
    RewriteRule ^signin\.html$ /sign-in [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+suggestedsamecategory\.html[?\s] [NC]
    RewriteRule ^suggestedsamecategory\.html$ /suggested/same-category [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+suggestedtoppicks\.php[?\s] [NC]
    RewriteRule ^suggestedtoppicks\.php$ /suggested/top-picks [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+support\.html[?\s] [NC]
    RewriteRule ^support\.html$ /support [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+termsandconditions\.html[?\s] [NC]
    RewriteRule ^termsandconditions\.html$ /terms-and-conditions [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+topratedsellerscentral\.html[?\s] [NC]
    RewriteRule ^topratedsellerscentral\.html$ /top-rated-sellers/central [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+topratedsellerseastern\.html[?\s] [NC]
    RewriteRule ^topratedsellerseastern\.html$ /top-rated-sellers/eastern [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+topratedsellersnorthern\.html[?\s] [NC]
    RewriteRule ^topratedsellersnorthern\.html$ /top-rated-sellers/northern [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+topratedsellerswestern\.html[?\s] [NC]
    RewriteRule ^topratedsellerswestern\.html$ /top-rated-sellers/western [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+trendinghotdeals\.html[?\s] [NC]
    RewriteRule ^trendinghotdeals\.html$ /trending/hot-deals [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+trendingseasonaltrends\.html[?\s] [NC]
    RewriteRule ^trendingseasonaltrends\.html$ /trending/seasonal-trends [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+vendorshops-apparel\.html[?\s] [NC]
    RewriteRule ^vendorshops-apparel\.html$ /vendor-shops/apparel [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+vendorshops-shoes\.html[?\s] [NC]
    RewriteRule ^vendorshops-shoes\.html$ /vendor-shops/shoes [R=301,L]
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/+php/visitor_profile\.php[?\s] [NC]
    RewriteRule ^php/visitor_profile\.php$ /visitor-profile [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # Keep existing relative assets and API calls working from nested pretty URLs.
    RewriteRule ^(categories|new-arrivals|suggested|top-rated-sellers|trending|vendor-shops)/(assets|php)/(.*)$ $2/$3 [L]

    # Extensionless public routes.
    RewriteRule ^about$ about.html [L]
    RewriteRule ^bulk-orders$ businessbulkorders.html [L]
    RewriteRule ^business-vendor-dashboard$ php/businessvendordashboard.php [L]
    RewriteRule ^add-new-listing$ php/addnewlisting.php [L]
    RewriteRule ^categories/agriculture-produce$ categoriesagriculture&produce.html [L]
    RewriteRule ^categories/apparel$ categoriesapparel.html [L]
    RewriteRule ^categories/automotive-transport$ categoriesautomotive&transport.html [L]
    RewriteRule ^categories/construction-building$ categoriesconstruction&building.html [L]
    RewriteRule ^categories/electronics-gadgets$ categorieselectronics&gagdets.html [L]
    RewriteRule ^categories/food-beverages$ categoriesfood&beverages.html [L]
    RewriteRule ^categories/furniture-home$ categoriesfurniture&home.html [L]
    RewriteRule ^categories/general-services$ categoriesgeneralservices.html [L]
    RewriteRule ^categories/health-beauty$ categorieshealth&beauty.html [L]
    RewriteRule ^categories/it-software$ categoriesit&software.html [L]
    RewriteRule ^categories/livestock-animals$ categorieslivestock&animals.html [L]
    RewriteRule ^categories/office-supply-stationery$ categoriesofficesupply&stationery.html [L]
    RewriteRule ^categories/printing-branding$ categoriesprinting&branding.html [L]
    RewriteRule ^categories/wholesale-retail$ categorieswholesale&retail.html [L]
    RewriteRule ^create-account$ createaccount.html [L]
    RewriteRule ^feedback$ feedback.html [L]
    RewriteRule ^help$ help.html [L]
    RewriteRule ^new-arrivals/central$ newarrivalscentral.php [L]
    RewriteRule ^new-arrivals/eastern$ newarrivalseastern.php [L]
    RewriteRule ^new-arrivals/northern$ newarrivalsnorthern.php [L]
    RewriteRule ^new-arrivals/western$ newarrivalswestern.php [L]
    RewriteRule ^offers-discounts$ offers&discounts.html [L]
    RewriteRule ^privacy-policy$ privacypolicy.html [L]
    RewriteRule ^profile$ php/profile.php [L]
    RewriteRule ^purchase-wholesale$ purchasewholesale.html [L]
    RewriteRule ^recently-viewed$ recentlyviewed.html [L]
    RewriteRule ^sign-in$ signin.html [L]
    RewriteRule ^suggested/same-category$ suggestedsamecategory.html [L]
    RewriteRule ^suggested/top-picks$ suggestedtoppicks.php [L]
    RewriteRule ^support$ support.html [L]
    RewriteRule ^terms-and-conditions$ termsandconditions.html [L]
    RewriteRule ^top-rated-sellers/central$ topratedsellerscentral.html [L]
    RewriteRule ^top-rated-sellers/eastern$ topratedsellerseastern.html [L]
    RewriteRule ^top-rated-sellers/northern$ topratedsellersnorthern.html [L]
    RewriteRule ^top-rated-sellers/western$ topratedsellerswestern.html [L]
    RewriteRule ^trending/hot-deals$ trendinghotdeals.html [L]
    RewriteRule ^trending/seasonal-trends$ trendingseasonaltrends.html [L]
    RewriteRule ^vendor-shops/apparel$ vendorshops-apparel.html [L]
    RewriteRule ^vendor-shops/shoes$ vendorshops-shoes.html [L]
    RewriteRule ^visitor-profile$ php/visitor_profile.php [L]
</IfModule>

<IfModule mod_alias.c>
    RedirectMatch 403 "(^|/)\.(?!well-known(?:/|$))"
</IfModule>

<FilesMatch "(?i)(^\.|~$|^config$|^settings$|^credentials$|^phpinfo\.php$|_cli\.php$|\.bak$|\.backup$|\.conf$|\.config$|\.db$|\.dist$|\.dump$|\.ini$|\.log$|\.old$|\.orig$|\.save$|\.sql$|\.sqlite$|\.sqlite3$|\.swp$|\.tmp$|composer\.(json|lock)$|package(-lock)?\.json$|yarn\.lock$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
